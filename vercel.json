{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "src/clinical_news/web/static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/src/clinical_news/web/static/$1" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
