# Gemini — accepts either a single key or a comma-separated list.
# When more than one is configured, the pool rotates on 429/auth errors so a
# single key hitting its daily cap doesn't block the run.
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Optional Gemini overrides
# GEMINI_GEN_MODEL=gemini-flash-latest
# GEMINI_MIN_INTERVAL_S=5.0
# GEMINI_MAX_OUTPUT_TOKENS=8000

# Optional Claude polish
CLAUDE_API_KEY=

# Email delivery
GMAIL_FROM=
GMAIL_TO=
GMAIL_APP_PASSWORD=

# Web UI admin password (HTTP Basic) — required for /admin/* routes
ADMIN_PASSWORD=

# Storage / logging
DB_PATH=app_data/articles.db
LOG_LEVEL=INFO
